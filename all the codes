@model FeedbackManagementApp.Models.Feedback  
  
<div class="card mb-3 border-0 shadow-sm rounded-3 border-start border-4 @(Model.Rating >= 4  
? "border-success" : Model.Rating == 3 ? "border-warning" : "border-danger")">     
<div class="card-body p-4">  
        <div class="d-flex justify-content-between align-items-center mb-2">  
            <div>  
                <h5 class="fw-bold mb-0 text-dark">@Model.FullName</h5>  
                 <small class="badge bg-light text-secondary border mt
1">@Model.Category</small>  
            </div>  
            <div class="text-warning fs-5 fw-bold">  
                @for (int i = 0; i < Model.Rating; i++)  
                {  
                    <span>★</span>  
                }  
                @for (int i = Model.Rating; i < 5; i++)  
                {  
                    <span class="text-muted opacity-25">★</span>  
                }  
                <small class="text-dark fs-6 ms-1">(@Model.Rating/5)</small>  
            </div>  
        </div>  
  
         <p class="card-text my-3 text-secondary" style="white-space: pre
line;">@Model.Comments</p>   
        <div class="d-flex justify-content-between align-items-center text-muted small pt-2 
border-top">  
            <span><strong>Email:</strong> @Model.Email</span>  
  
            <span><i class="bi bi-clock"></i> @Model.SubmittedOn.ToString("MMM dd, yyyy · hh:mm 
tt")</span>  
        </div>  
    </div>  
</div>  
  
