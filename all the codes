@model IEnumerable<FeedbackManagementApp.Models.Feedback>  
  
@{  
    ViewData["Title"] = "Feedback Dashboard";  
}  
  
<div class="my-4">  
    <div class="d-flex justify-content-between align-items-center mb-4">         
<div>  
            <h2 class="fw-bold m-0 text-dark">Feedback Overview</h2>  
            <p class="text-muted m-0">Real-time user feedback and analytics</p>         
</div>  
         <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">+ Submit New  
Feedback</a>  
    </div>  
  
    <!-- Alert Banner -->  
    @if (TempData["SuccessMessage"] != null)  
    {  
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">  
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]  
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria
label="Close"></button>  
        </div>  
    }  
  
    <!-- Analytics Counters -->  
    <div class="row g-3 mb-4">  
        <div class="col-md-4">  
            <div class="card border-0 shadow-sm bg-white p-3 text-center rounded-3">  
                <span class="text-muted text-uppercase fw-bold small">Total Responses</span>  
                <h2 class="fw-bold text-primary m-0 mt-1">@ViewBag.TotalCount</h2>  
            </div>  
        </div>  
        <div class="col-md-4">  
            <div class="card border-0 shadow-sm bg-white p-3 text-center rounded-3">  
                <span class="text-muted text-uppercase fw-bold small">Average Rating</span>  
                 <h2 class="fw-bold text-warning m-0  
mt-1">@ViewBag.AverageRating.ToString("0.0") <small class="fs-6 text-muted">/ 5</small></h2>  
            </div>  
        </div>  
        <div class="col-md-4">  
            <div class="card border-0 shadow-sm bg-white p-3 text-center rounded-3">  
                <span class="text-muted text-uppercase fw-bold small">Positive Sentiment (4 ★ & 
5★)</span>  
                <h2 class="fw-bold text-success m-0 mt-1">@ViewBag.PositivePercentage%</h2>  
  
            </div>  
        </div>  
    </div>  
  
    <!-- Feedback Entries rendered using Partial View -->  
    <div class="row">  
        <div class="col-12">  
            @if (!Model.Any())  
            {  
                <div class="card border-0 shadow-sm p-5 text-center my-3">  
                    <h4 class="text-muted mb-3">No feedback submissions found yet.</h4>                     
<div>  
                        <a asp-action="Create" class="btn btn-outline-primary px-4">Be the first 
to submit feedback</a>                     </div>  
                </div>  
            }             
else  
            {  
                @foreach (var item in Model.OrderByDescending(f => f.SubmittedOn))                 
{  
                    @await Html.PartialAsync("_FeedbackItem", item)  
                }  
            }  
        </div>  
    </div>  
</div>  
  
