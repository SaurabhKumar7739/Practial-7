@model FeedbackManagementApp.Models.Feedback  
  
@{  
    ViewData["Title"] = "Submit Feedback";  
}  
  
<style>  
    /* Radio-based Interactive CSS Star Rating Control */  
    .star-rating {         
display: flex;  
        flex-direction: row-reverse;         justify
content: flex-end;  
        gap: 0.25rem;  
    }  
  
        .star-rating input {             
display: none;  
        }  
  
        .star-rating label {             
font-size: 2.2rem;             
color: #ddd;             cursor: 
pointer;  
            transition: color 0.2s ease-in-out;  
        }  
  
  
            .star-rating input:checked ~ label,  
            .star-rating label:hover,  
            .star-rating label:hover ~ label {  
                color: #ffc107;  
            }  
</style>  
  
<div class="row justify-content-center my-4">  
    <div class="col-lg-7 col-md-9">  
        <div class="card shadow border-0 rounded-4">  
            <div class="card-header bg-primary bg-gradient text-white p-4 rounded-top-4">  
                <h3 class="mb-1 fw-bold">Share Your Experience</h3>  
                <p class="mb-0 text-white-50">We value your input to continuously improve our 
platform.</p>  
            </div>  
  
            <div class="card-body p-4 p-md-5">  
                @using (Html.BeginForm("Create", "Feedback", FormMethod.Post))                 
{  
                    @Html.AntiForgeryToken()  
  
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => 
v.Errors.Count > 0))  
                    {  
                        <div class="alert alert-danger mb-4">  
                            @Html.ValidationSummary(false, "Please correct the errors below 
before submitting:")  
                        </div>  
                    }  
  
                    <!-- Full Name & Email -->  
                    <div class="row g-3 mb-3">  
                        <div class="col-md-6">  
                            @Html.LabelFor(m => m.FullName, new { @class = "form-label fw
semibold" })  
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control 
form-control-lg", placeholder = "John Doe" })  
                             @Html.ValidationMessageFor(m => m.FullName, "", new { @class =  
"text-danger small" })  
                        </div>  
                        <div class="col-md-6">  
                            @Html.LabelFor(m => m.Email, new { @class = "form-label fw
semibold" })  
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control form
control-lg", placeholder = "john@example.com" })  
                             @Html.ValidationMessageFor(m => m.Email, "", new { @class =  
"text-danger small" })  
                        </div>  
                    </div>  
  
                    <!-- Category Dropdown -->  
                    <div class="mb-3">  
                        @Html.LabelFor(m => m.Category, new { @class = "form-label fw-semibold"  
})  
  
                        @Html.DropDownListFor(m => m.Category, new SelectList(new[]  
                        {  
                            "General Feedback",  
                                        "Bug / Technical Issue",  
                                        "Feature Request",  
                                        "User Interface / Design",  
                                        "Other"  
                                         }), "-- Select Category --", new { @class =  
"form-select form-select-lg" })  
                    @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger 
small" })  
                </div>  
  
                <!-- Star Rating (HTML Helper bound via Radio Buttons) -->  
                <div class="mb-3">  
                    @Html.LabelFor(m => m.Rating, new { @class = "form-label fw-semibold d
block" })  
                    <div class="star-rating mb-1">  
                        <input type="radio" id="star5" name="Rating" value="5" @(Model?.Rating  
== 5 ? "checked" : "") />  
                        <label for="star5" title="5 Stars"> ★</label>  
  
                        <input type="radio" id="star4" name="Rating" value="4" @(Model?.Rating  
== 4 ? "checked" : "") />  
                        <label for="star4" title="4 Stars"> ★</label>  
  
                        <input type="radio" id="star3" name="Rating" value="3" @(Model?.Rating  
== 3 ? "checked" : "") />  
                        <label for="star3" title="3 Stars"> ★</label>  
  
                        <input type="radio" id="star2" name="Rating" value="2" @(Model?.Rating  
== 2 ? "checked" : "") />  
                        <label for="star2" title="2 Stars"> ★</label>  
  
                        <input type="radio" id="star1" name="Rating" value="1" @(Model?.Rating  
== 1 ? "checked" : "") />  
                        <label for="star1" title="1 Star"> ★</label>  
                    </div>  
                    @Html.ValidationMessageFor(m => m.Rating, "", new { @class = "text-danger 
small d-block" })  
                </div>  
  
                <!-- Comments Textarea -->  
                <div class="mb-4">  
                    @Html.LabelFor(m => m.Comments, new { @class = "form-label fw-semibold" })  
                    @Html.TextAreaFor(m => m.Comments, new { @class = "form-control", rows = 4, 
placeholder = "Tell us what you liked or what we can improve..." })  
                    @Html.ValidationMessageFor(m => m.Comments, "", new { @class = "text-danger 
small" })  
                </div>  
  
                <!-- Actions -->  
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">  
  
                     <a asp-action="Index" class="btn btn-outline-secondary px-4">View All 
Submissions</a>  
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm">Submit  
Feedback</button>  
                </div>  
                                }  
            </div>  
        </div>  
    </div>  
</div>  
  
@section Scripts {  
    @{  
        await Html.RenderPartialAsync("_ValidationScriptsPartial");  
    }  
}  
  
